# Postgres connection string. From your Supabase project: Settings > Database > Connection string.
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Supabase Auth — Settings > API in your Supabase project.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Symmetric key used to encrypt Shopify access tokens at rest (any long random string).
TOKEN_ENCRYPTION_KEY="replace-with-a-long-random-secret"

# Shopify app credentials — from your Partner dashboard app.
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_WEBHOOK_SECRET=""
SHOPIFY_SCOPES="read_products,read_orders,read_customers,read_inventory"
# Public base URL this app is reachable at (use an https tunnel like ngrok for local dev).
SHOPIFY_APP_URL="http://localhost:3000"

# Optional second Shopify app (custom distribution) for specific stores the main app can't be
# installed on yet. Shops listed here connect through it; everyone else uses the main app above.
# Its App URL / redirect URL must be the same as the main app's. Leave empty if unused.
SHOPIFY_ALT_API_KEY=""
SHOPIFY_ALT_API_SECRET=""
SHOPIFY_ALT_SHOPS="" # comma-separated, e.g. "your-store.myshopify.com"

# Billing (Stripe). Leave empty to keep billing off — the dashboard stays free until both of the
# first two are set. Price: Stripe dashboard > Product catalog > your plan's recurring price (price_...).
# Webhook: Developers > Webhooks > endpoint https://<your-domain>/api/billing/webhook, events
# customer.subscription.* — then copy its signing secret (whsec_...).
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""

# Public base URL of this app (no trailing slash). Used for OAuth redirects and links in emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vercel Cron sends this as a bearer token to /api/cron/daily. Any long random string.
CRON_SECRET=""

# Meta (Facebook/Instagram) Ads — developers.facebook.com > your app > Settings > Basic.
META_APP_ID=""
META_APP_SECRET=""
# Bearer token for calling /api/meta/sync and /api/meta/rollup from scripts. Any long random string.
META_SYNC_API_KEY=""

# AI product copy, creative ideas and approval explanations (console.anthropic.com). Leave empty to disable AI.
ANTHROPIC_API_KEY=""

# Email (invitations, alerts) via Resend. EMAIL_FROM needs a domain verified in Resend.
RESEND_API_KEY=""
EMAIL_FROM=""

# Where Shopify's customer data-request / redaction notices are emailed.
COMPLIANCE_CONTACT_EMAIL=""

# Optional Slack/Discord incoming-webhook URL; server errors are posted here (rate-limited).
ALERT_WEBHOOK_URL=""
