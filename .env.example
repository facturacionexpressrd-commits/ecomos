# EcomOS Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# Database (Supabase PostgreSQL)
# ============================================================================
DATABASE_URL=postgresql://[user]:[password]@[host]:[port]/[database]

# ============================================================================
# Supabase Configuration
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://[project].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[your-anon-key]
SUPABASE_SERVICE_ROLE_KEY=[your-service-role-key]

# ============================================================================
# Shopify Integration
# ============================================================================
SHOPIFY_API_KEY=[your-shopify-api-key]
SHOPIFY_API_SECRET=[your-shopify-api-secret]
SHOPIFY_WEBHOOK_SECRET=[your-webhook-secret]

# ============================================================================
# Meta (Facebook) Ads Integration
# ============================================================================
META_APP_ID=[your-meta-app-id]
META_APP_SECRET=[your-meta-app-secret]
NEXT_PUBLIC_META_APP_ID=[your-meta-app-id]
META_WEBHOOK_TOKEN=[your-meta-webhook-token]

# ============================================================================
# Runable AI Integration (NEW)
# ============================================================================

# Main Runable AI API Key (obtained from Runable Dashboard)
# Sign up at https://runable.ai
RUNABLE_API_KEY=ru_[your-runable-api-key]

# Runable API endpoint
RUNABLE_API_URL=https://api.runable.ai

# Webhook secret for Runable to sign requests
# Generate a random 32+ character string
RUNABLE_WEBHOOK_SECRET=[generate-random-secret]

# Callback URL for Runable to report execution results
# Used in production
RUNABLE_CALLBACK_URL=https://[your-domain]/api/runable/webhook

# Encryption key for storing Runable API keys in database
# Generate with: openssl rand -hex 32
RUNABLE_ENCRYPTION_KEY=[your-encryption-key]

# Default Runable agent config (JSON, can be overridden per agent)
# Example for campaign_manager agent:
RUNABLE_DEFAULT_CONFIG={"campaign_manager":{"min_roas":2.0,"daily_budget":50,"max_cpc":1.50,"auto_scaling_enabled":true,"pause_on_low_roas":true}}

# ============================================================================
# AI / Claude API
# ============================================================================
ANTHROPIC_API_KEY=[your-anthropic-api-key]

# ============================================================================
# Email (Resend)
# ============================================================================
RESEND_API_KEY=[your-resend-api-key]
EMAIL_FROM=noreply@[your-domain]

# ============================================================================
# Billing (Stripe)
# ============================================================================
STRIPE_SECRET_KEY=[your-stripe-secret-key]
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=[your-stripe-publishable-key]
STRIPE_WEBHOOK_SECRET=[your-stripe-webhook-secret]

# ============================================================================
# Application Configuration
# ============================================================================
NODE_ENV=development

# Enable debug logging
DEBUG=false

# Feature flags
ENABLE_RUNABLE_AGENTS=true
ENABLE_META_INTEGRATION=true
ENABLE_PRODUCT_AI_COPY=true
