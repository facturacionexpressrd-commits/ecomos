// EcomOS — Phase 0 + Phase 1 schema. See DATABASE.md for rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Phase 4: Order Routing & Fulfillment ----------

model OrderRoute {
  id              String   @id @default(cuid())
  storeId         String
  orderId         String
  lineItemId      String   @unique // one route per line item
  supplierOfferId String
  // Decision made by routing algorithm
  routedAt        DateTime @default(now())
  routedBy        String?  // user ID if manual, null if auto
  reason          String?  // why this supplier was chosen
  createdAt       DateTime @default(now())

  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lineItem      OrderLineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  supplierOffer SupplierOffer @relation(fields: [supplierOfferId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([supplierOfferId])
}

// SupplierOrder groups line items routed to the same supplier
model SupplierOrder {
  id              String   @id @default(cuid())
  storeId         String
  orderId         String
  supplier        SupplierName
  supplierOrderId String?  // supplier's own order ID (pulled from their API)
  // Aggregated from line items
  totalCost       Decimal  @db.Decimal(12, 2) // sum of offer costs
  totalShipping   Decimal  @db.Decimal(12, 2)
  estimatedMargin Decimal  @db.Decimal(12, 2) // estimated contribution profit
  // Status from supplier
  status          String   @default("pending") // pending, confirmed, shipped, delivered, cancelled
  submittedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  store        Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order        Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fulfillments Fulfillment[]
  exceptions   FulfillmentException[]

  @@unique([orderId, supplier])
  @@index([storeId, status])
  @@index([supplier])
}

// Fulfillment tracks the end-to-end fulfillment of a supplier order
model Fulfillment {
  id              String   @id @default(cuid())
  supplierOrderId String   @unique // one fulfillment per supplier order
  status          String   @default("pending") // pending, processing, shipped, delivered, failed
  failureReason   String?
  shipmentId      String?  @unique // links to shipment when it ships
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplierOrder SupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)
  shipment      Shipment?     @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@index([status])
}

// Shipment contains tracking info (one per fulfillment)
model Shipment {
  id                String   @id @default(cuid())
  carrier           String?  // FedEx, UPS, etc. (if supplier provides it)
  trackingNumber    String?
  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  fulfillment Fulfillment?
  events      TrackingEvent[]

  @@index([trackingNumber])
}

// TrackingEvent: status updates (in transit, out for delivery, delivered, exception)
model TrackingEvent {
  id         String   @id @default(cuid())
  shipmentId String
  status     String   // in_transit, out_for_delivery, delivered, exception, returned
  message    String?
  timestamp  DateTime
  createdAt  DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, timestamp])
}

enum FulfillmentExceptionType {
  out_of_stock
  address_invalid
  payment_failed
  customs_delay
  damage_in_transit
  carrier_exception
  supplier_error
  other
}

// FulfillmentException: issues during fulfillment
model FulfillmentException {
  id              String   @id @default(cuid())
  supplierOrderId String
  exceptionType   FulfillmentExceptionType
  severity        String   @default("medium") // low, medium, high, critical
  description     String
  // Recommendations left as plain text for now (AI comes later)
  recommendedAction String?
  isResolved      Boolean  @default(false)
  resolvedAt      DateTime?
  resolvedBy      String?  // user ID
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplierOrder SupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)

  @@index([supplierOrderId, isResolved])
  @@index([severity])
}

// ---------- Phase 3: Canonical Products & Supplier Offers ----------

model CanonicalProduct {
  id        String   @id @default(cuid())
  // External identifiers for matching across suppliers
  // (barcode, SKU, internal ID — user provides one or more)
  externalId String?
  sku        String?
  barcode    String?
  title      String   @db.VarChar(255)
  description String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  offers        SupplierOffer[]
  productMappings ProductMapping[]
  approvalActions ApprovalAction[]

  @@index([externalId])
  @@index([sku])
  @@index([barcode])
}

enum SupplierName {
  autods
  spocket
  printful
  zendrop
}

model SupplierOffer {
  id              String   @id @default(cuid())
  canonicalProductId String
  supplier        SupplierName
  // Data pulled from supplier API
  supplierProductId String?  // supplier's own ID (for linking back to their API)
  cost            Decimal  @db.Decimal(12, 2)
  shippingCost    Decimal  @db.Decimal(12, 2)
  shippingDays    Int      // estimated delivery days
  availableQty    Int      @default(0)
  lastSyncedAt    DateTime?
  syncStatus      String?  // "success", "error", error message
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  canonicalProduct CanonicalProduct @relation(fields: [canonicalProductId], references: [id], onDelete: Cascade)
  orderRoutes      OrderRoute[]

  @@unique([canonicalProductId, supplier])
  @@index([supplier])
}

// Maps a Shopify Product to a CanonicalProduct (one-to-one per store)
model ProductMapping {
  id                String @id @default(cuid())
  storeId           String
  shopifyProductId  String // links to Product.id
  canonicalProductId String
  // When the user maps the product, who did it and why
  mappedBy          String? // user ID
  mappedAt          DateTime @default(now())
  notes             String?

  store               Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  canonicalProduct    CanonicalProduct @relation(fields: [canonicalProductId], references: [id], onDelete: Cascade)

  @@unique([storeId, shopifyProductId])
  @@index([canonicalProductId])
}

enum ApprovalActionType {
  supplier_switch
  inventory_adjustment
  pricing_override
}

model ApprovalAction {
  id                String   @id @default(cuid())
  storeId           String
  canonicalProductId String
  actionType        ApprovalActionType
  // Supplier switching context
  fromSupplier      SupplierName?
  toSupplier        SupplierName?
  // Who requested this
  requestedBy       String // user ID
  requestedAt       DateTime @default(now())
  // Approval state
  status            String   @default("pending") // pending, approved, rejected, implemented
  approvedBy        String?  // user ID
  approvedAt        DateTime?
  // Why
  reason            String?  @db.Text
  metadata          Json?

  store               Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  canonicalProduct    CanonicalProduct @relation(fields: [canonicalProductId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@index([canonicalProductId])
}

// ---------- Phase 0: org, users, RBAC ----------

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users       User[]
  roles       Role[]
  stores      Store[]
  invitations Invitation[]
  auditLogs   AuditLog[]
}

// id matches the Supabase auth.users.id (uuid) — no separate password/identity here.
model User {
  id             String   @id
  organizationId String
  email          String   @unique
  name           String?
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  storeAccess  UserStoreAccess[]
  auditLogs    AuditLog[]

  @@index([organizationId])
}

// Capability-based role: a flat list of capability strings (e.g. "store:read",
// "store:sync", "orders:read", "org:manage_users"). No fixed admin/editor/viewer
// enum — new capabilities are additive, never require a schema migration.
model Role {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  capabilities   String[]
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  access       UserStoreAccess[]
  invitations  Invitation[]

  @@unique([organizationId, name])
}

model Store {
  id                   String    @id @default(cuid())
  organizationId       String
  name                 String
  platform             Platform  @default(shopify)
  shopDomain           String    @unique
  accessTokenEncrypted String?
  scope                String?
  status               StoreStatus @default(pending)
  // Estimated payment processing fee: percent of sold revenue + fixed amount per order.
  // Shopify's real per-transaction fees are not synced, so this is an estimate, not actuals.
  paymentFeePercent    Decimal   @default(2.9) @db.Decimal(5, 3)
  paymentFeeFixed      Decimal   @default(0.30) @db.Decimal(8, 2)
  connectedAt          DateTime?
  createdAt            DateTime  @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  access       UserStoreAccess[]
  invitations  Invitation[]
  auditLogs    AuditLog[]

  products         Product[]
  productVariants  ProductVariant[]
  orders           Order[]
  customers        Customer[]
  inventoryLevels  InventoryLevel[]
  webhookEvents    WebhookEvent[]

  creativeIdeas    CreativeIdea[]
  creativeAssets   CreativeAsset[]

  watchlist        ResearchWatchlist[]
  competitors      CompetitorProduct[]

  approvals        ApprovalAction[]

  costAllocations    CostAllocation[]
  dailyFinancials    DailyFinancialMetric[]
  orderLineItems     OrderLineItem[]
  refunds            Refund[]
  financialTransactions FinancialTransaction[]

  productMappings    ProductMapping[]
  approvalActions    ApprovalAction[]
  orderRoutes        OrderRoute[]
  supplierOrders     SupplierOrder[]

  metaAccounts       MetaAccount[]
  metaCampaigns      MetaCampaign[]
  metaSpendDaily     MetaSpendDaily[]
  orderAttributions  OrderAttributionMeta[]
  metaAdSets         MetaAdSet[]
  metaCreatives      MetaCreative[]

  productAICopy      ProductAICopy[]

  @@index([organizationId])
}

enum Platform {
  shopify
}

enum StoreStatus {
  pending
  connected
  error
}

// The one join table capability checks read: which role a user holds for a store.
model UserStoreAccess {
  id      String @id @default(cuid())
  userId  String
  storeId String
  roleId  String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([storeId])
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  roleId         String
  storeId        String?
  token          String           @unique
  status         InvitationStatus @default(pending)
  invitedBy      String
  expiresAt      DateTime
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  store        Store?       @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  storeId        String?
  action         String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  store        Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

// ---------- Phase 1: Shopify sync ----------

model Product {
  id           String   @id @default(cuid())
  storeId      String
  shopifyGid   String
  title        String
  status       String?
  raw          Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store              Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants           ProductVariant[]
  aiGeneratedContent ProductAICopy[]
  creativeIdeas      CreativeIdea[]

  @@unique([storeId, shopifyGid])
}

// AI-generated product copy suggestions
model ProductAICopy {
  id                String   @id @default(cuid())
  storeId           String
  productId         String
  headline          String
  description       String   @db.Text
  bulletPoints      String[] // JSON array stored as text
  seoKeywords       String[]
  aiProvider        String   // "claude", etc.
  confidence        Float    @default(0.8)
  isPublished       Boolean  @default(false)
  publishedAt       DateTime?
  publishedHeadline String?  // what was actually published
  publishedDescription String? @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId, productId])
  @@index([isPublished])
}

// Approval actions: AI recommendations awaiting human approval
model ApprovalAction {
  id                String   @id @default(cuid())
  storeId           String
  actionType        String   // "supplier_add", "budget_update", "creative_approval", etc.
  title             String
  description       String   @db.Text
  data              Json     // action-specific data (varies by type)
  priority          String   // "low", "medium", "high", "critical"
  confidenceScore   Decimal  @db.Decimal(3, 2) // 0-1
  reasoning         String   @db.Text
  executiveExplanation String @db.Text
  status            String   @default("pending") // "pending", "approved", "rejected", "completed"
  approvedBy        String?
  approvedAt        DateTime?
  rejectionReason   String?
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@index([priority])
  @@index([createdAt])
}

// Watchlist for research + opportunity tracking
model ResearchWatchlist {
  id                String   @id @default(cuid())
  storeId           String
  externalProductId String   // supplier's product ID
  productTitle      String
  cost              Decimal  @db.Decimal(12, 2)
  estimatedRetailPrice Decimal @db.Decimal(12, 2)
  shippingCost      Decimal? @db.Decimal(12, 2)
  margin            Decimal  @db.Decimal(5, 4) // stored as decimal (0-1)
  opportunityScore  Decimal  @db.Decimal(5, 2) // 0-100
  competitionLevel  String   @default("medium") // low, medium, high
  demandSignals     String[] // JSON array
  notes             String?  @db.Text
  status            String   @default("watching") // watching, contacted, purchased, archived
  lastCheckedAt     DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@index([opportunityScore])
  @@index([createdAt])
}

// Competitor products being tracked
model CompetitorProduct {
  id                String   @id @default(cuid())
  storeId           String
  competitorName    String   // "AliExpress Seller A", "Amazon Reseller B"
  externalProductId String
  productTitle      String
  price             Decimal  @db.Decimal(12, 2)
  shippingCost      Decimal? @db.Decimal(12, 2)
  rating            Decimal? @db.Decimal(3, 2)
  reviewCount       Int      @default(0)
  lastUpdatedAt     DateTime?
  createdAt         DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, competitorName])
  @@index([createdAt])
}

// Creative ideas generated by AI
model CreativeIdea {
  id                String   @id @default(cuid())
  storeId           String
  productId         String
  headlineText      String
  headlineHook      String
  headlineCta       String
  imageConceptText  String   @db.Text
  videoConceptText  String   @db.Text
  targetAudience    String
  emotionalApeals   String[] // JSON array
  aiProvider        String   @default("claude")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  store     Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  creatives CreativeAsset[]

  @@index([storeId, productId])
  @@index([createdAt])
}

// Generated image assets for creative ideas
model CreativeAsset {
  id             String   @id @default(cuid())
  storeId        String
  creativeIdeaId String
  type           String   // "image" or "video"
  concept        String   // "minimalist", "lifestyle", etc.
  style          String?
  url            String   @db.Text // S3 URL or similar
  prompt         String   @db.Text // the prompt used to generate
  thumbnailUrl   String?  @db.Text // for videos
  duration       Int?     // for videos, in seconds
  status         String   @default("generated") // generated, approved, rejected
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime @default(now())

  store       Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  creativeIdea CreativeIdea @relation(fields: [creativeIdeaId], references: [id], onDelete: Cascade)

  @@index([storeId, creativeIdeaId])
  @@index([status])
}

model ProductVariant {
  id         String   @id @default(cuid())
  storeId    String
  productId  String
  shopifyGid String
  sku        String?
  title      String?
  price      Decimal? @db.Decimal(12, 2)
  cost       Decimal? @db.Decimal(12, 2) // manual COGS entry per variant
  raw        Json
  updatedAt  DateTime @updatedAt

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  inventoryLevels InventoryLevel[]
  costAllocations CostAllocation[]
  lineItems       OrderLineItem[]

  @@unique([storeId, shopifyGid])
  @@index([productId])
}

model Customer {
  id         String   @id @default(cuid())
  storeId    String
  shopifyGid String
  email      String?
  name       String?
  raw        Json
  updatedAt  DateTime @updatedAt

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([storeId, shopifyGid])
}

model Order {
  id            String   @id @default(cuid())
  storeId       String
  customerId    String?
  shopifyGid    String
  name          String
  totalPrice    Decimal  @db.Decimal(12, 2)
  currency      String
  financialStatus String?
  raw           Json
  placedAt      DateTime
  updatedAt     DateTime @updatedAt

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  metaAttribution    OrderAttributionMeta? // 0..1 relation, populated by attribution job
  lineItems          OrderLineItem[]
  refunds            Refund[]
  transactions       FinancialTransaction[]
  orderRoutes        OrderRoute[]
  supplierOrders     SupplierOrder[]

  @@unique([storeId, shopifyGid])
  @@index([storeId, placedAt])
}

model InventoryLevel {
  id         String   @id @default(cuid())
  storeId    String
  variantId  String
  locationGid String
  available  Int
  updatedAt  DateTime @updatedAt

  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, locationGid])
}

// Idempotency ledger for Shopify webhooks — the unique constraint on
// shopifyWebhookId is what makes double-delivery a no-op.
model WebhookEvent {
  id               String    @id @default(cuid())
  storeId          String
  shopifyWebhookId String    @unique
  topic            String
  receivedAt       DateTime  @default(now())
  processedAt      DateTime?
  status           WebhookStatus @default(received)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, topic])
}

enum WebhookStatus {
  received
  processed
  failed
}

// ---------- Phase 1.5: Finance layer ----------

// Cost allocation per variant (e.g., COGS, packaging, shipping)
model CostAllocation {
  id        String   @id @default(cuid())
  storeId   String
  variantId String
  costType  String   // cogs, packaging, shipping, labor
  amount    Decimal  @db.Decimal(12, 2)
  notes     String?
  createdAt DateTime @default(now())

  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([variantId])
}

// Revenue fact per sold line (this is the "revenue record" — one row per order line).
// Amounts are Shopify shopMoney, before tax and shipping. netAmount is after discounts.
model OrderLineItem {
  id         String   @id @default(cuid())
  storeId    String
  orderId    String
  variantId  String?  // null if the variant was deleted in Shopify
  shopifyGid String
  quantity   Int
  grossAmount Decimal @db.Decimal(12, 2) // before discounts
  netAmount   Decimal @db.Decimal(12, 2) // after discounts
  createdAt  DateTime @default(now())

  store   Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  refundLines RefundLine[]
  orderRoute  OrderRoute?

  @@unique([orderId, shopifyGid])
  @@index([storeId])
  @@index([variantId])
}

model Refund {
  id         String   @id @default(cuid())
  storeId    String
  orderId    String
  shopifyGid String
  amount     Decimal  @db.Decimal(12, 2) // total refunded incl. tax/shipping
  refundedAt DateTime
  createdAt  DateTime @default(now())

  store Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lines RefundLine[]

  @@unique([storeId, shopifyGid])
  @@index([orderId])
}

model RefundLine {
  id          String  @id @default(cuid())
  refundId    String
  lineItemId  String?
  quantity    Int
  subtotal    Decimal @db.Decimal(12, 2) // refunded product amount, before tax

  refund   Refund         @relation(fields: [refundId], references: [id], onDelete: Cascade)
  lineItem OrderLineItem? @relation(fields: [lineItemId], references: [id], onDelete: SetNull)

  @@unique([refundId, lineItemId])
  @@index([refundId])
  @@index([lineItemId])
}

// Payment ledger as reported by Shopify (sale/capture/refund...). Amounts only —
// Shopify processing fees are not synced, see Store.paymentFeePercent.
model FinancialTransaction {
  id          String    @id @default(cuid())
  storeId     String
  orderId     String
  shopifyGid  String
  kind        String
  status      String
  gateway     String?
  amount      Decimal   @db.Decimal(12, 2)
  currency    String
  processedAt DateTime?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([storeId, shopifyGid])
  @@index([orderId])
}

// Daily rollup of financial metrics for a store
model DailyFinancialMetric {
  id              String   @id @default(cuid())
  storeId         String
  date            DateTime @db.Date
  grossRevenue    Decimal  @db.Decimal(12, 2) // sum of order totalPrice
  refunds         Decimal  @db.Decimal(12, 2) @default(0)
  fees            Decimal  @db.Decimal(12, 2) @default(0) // payment processing fees
  cogs            Decimal  @db.Decimal(12, 2) @default(0)
  contributionProfit Decimal @db.Decimal(12, 2) // = grossRevenue - refunds - fees - cogs
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, date])
  @@index([storeId, date])
}

// ---------- Phase 2: Meta Ads Integration ----------

model MetaAccount {
  id                  String   @id @default(cuid())
  storeId             String
  metaBusinessId      String   @unique
  metaAccountId       String   @unique
  accessTokenEncrypted String  // encrypted OAuth token
  scope               String   // granted permissions (ads_read, etc.)
  status              MetaStatus @default(connected)
  lastSyncedAt        DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  store     Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  campaigns MetaCampaign[]

  @@index([storeId])
}

enum MetaStatus {
  connected
  disconnected
  expired
  error
}

model MetaCampaign {
  id            String   @id @default(cuid())
  storeId       String
  metaAccountId String
  metaCampaignId String  // Meta's campaign ID
  name          String
  status        String   // ACTIVE, PAUSED, DELETED, etc.
  objective     String   // LINK_CLICKS, CONVERSIONS, etc.
  totalSpend    Decimal  @db.Decimal(12, 2) @default(0)
  impressions   Int      @default(0)
  clicks        Int      @default(0)
  conversions   Int      @default(0)
  dailyBudget   Decimal? @db.Decimal(12, 2) // campaign-level budget intent
  syncedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store         Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  metaAccount   MetaAccount          @relation(fields: [metaAccountId], references: [id], onDelete: Cascade)
  spendDaily    MetaSpendDaily[]
  attributions  OrderAttributionMeta[]
  adSets        MetaAdSet[]

  @@unique([storeId, metaCampaignId])
  @@index([storeId])
  @@index([metaAccountId])
}

model MetaSpendDaily {
  id              String   @id @default(cuid())
  storeId         String
  metaCampaignId  String
  date            DateTime @db.Date
  spend           Decimal  @db.Decimal(12, 2)
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  conversions     Int      @default(0)
  createdAt       DateTime @default(now())

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  campaign     MetaCampaign @relation(fields: [metaCampaignId], references: [id], onDelete: Cascade)

  @@unique([metaCampaignId, date])
  @@index([storeId, date])
  @@index([metaCampaignId])
}

// Attribution of Shopify orders to Meta campaigns via utm_campaign tracking
model OrderAttributionMeta {
  id              String   @id @default(cuid())
  storeId         String
  orderId         String   @unique
  metaCampaignId  String
  utmCampaign     String   // extracted from order source (utm_campaign parameter)
  confidence      Float    @default(1.0) // 1.0 = exact match, 0.5-0.9 = fuzzy match
  method          String   @default("utm_exact") // utm_exact, utm_fuzzy, etc.
  createdAt       DateTime @default(now())

  store    Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order    Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  campaign MetaCampaign @relation(fields: [metaCampaignId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([metaCampaignId])
}

// Ad sets within a campaign (targeting, budget, schedule)
model MetaAdSet {
  id              String   @id @default(cuid())
  storeId         String
  metaCampaignId  String
  metaAdSetId     String   @unique // Meta's ad set ID
  name            String
  status          String   @default("PAUSED") // ACTIVE, PAUSED, DELETED, etc.
  dailyBudget     Decimal? @db.Decimal(12, 2) // in cents
  lifetimeBudget  Decimal? @db.Decimal(12, 2) // in cents
  billingEvent    String   // IMPRESSIONS, CLICKS, CONVERSIONS, etc.
  optimizationGoal String // REACH, IMPRESSIONS, LINK_CLICKS, CONVERSIONS, etc.
  targeting       Json? // Meta targeting object (interests, demographics, etc.)
  startTime       DateTime?
  endTime         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  store    Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  campaign MetaCampaign @relation(fields: [metaCampaignId], references: [id], onDelete: Cascade)
  creatives MetaCreative[]

  @@unique([storeId, metaAdSetId])
  @@index([metaCampaignId])
  @@index([status])
}

// Creatives (ads) within an ad set
model MetaCreative {
  id            String   @id @default(cuid())
  storeId       String
  metaAdSetId   String
  metaCreativeId String  @unique // Meta's creative ID
  name          String
  status        String   @default("PAUSED")
  // Asset references (images, videos, copy)
  assetIds      String[] // Comma-separated asset IDs
  headline      String?
  bodyText      String?
  ctaText       String?
  imageUrl      String?
  videoUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store   Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  adSet   MetaAdSet  @relation(fields: [metaAdSetId], references: [id], onDelete: Cascade)

  @@index([metaAdSetId])
  @@index([status])
}
